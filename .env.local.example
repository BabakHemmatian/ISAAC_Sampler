# Firebase Auth config for ISAAC — copy this file to `.env.local` and paste the
# values from the Firebase console:
#   Project settings (gear) -> General -> Your apps -> SDK setup and configuration.
# These values ship in the browser bundle and are NOT secret, but they are
# environment-specific, so keep them out of source. CRA inlines REACT_APP_* at
# BUILD time — you must rebuild after changing them.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# Used for building password-reset / email-verification action links back to
# this site (already used by the app elsewhere). Set to the canonical origin.
REACT_APP_PUBLIC_ORIGIN=https://isaac.psychology.illinois.edu
